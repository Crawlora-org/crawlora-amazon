{
  "name": "crawlora/amazon",
  "description": "Crawlora Amazon API client with 5 endpoints for product search, suggestions, product details, and chart/category discovery",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "amazon",
    "amazon-api",
    "amazon-scraper",
    "amazon-data",
    "amazon-product-search",
    "amazon-suggestions",
    "amazon-product-details",
    "amazon-chart-category-discovery"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Amazon\\": "php/src/Crawlora/Amazon/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Amazon\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=amazon-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-amazon",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=amazon-php-api-docs"
  }
}
