{
  "name": "@crawlora-org/amazon",
  "version": "0.1.3",
  "description": "Crawlora Amazon API client with 5 endpoints for product search, suggestions, product details, and chart/category discovery",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=amazon-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-amazon/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "amazon", "amazon-api", "amazon-scraper", "amazon-data", "amazon-product-search", "amazon-suggestions", "amazon-product-details", "amazon-chart-category-discovery"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-amazon",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
