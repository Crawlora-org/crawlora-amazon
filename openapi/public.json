    "amazon.Product": {
      "properties": {
        "about": {
          "description": "Text of the product's feature bullet points (\"About this item\").",
          "type": "string"
        },
        "asin": {
          "description": "Amazon Standard Identification Number (ASIN) of the product.",
          "example": "B0DGJ736JM",
          "type": "string"
        },
        "availability": {
          "description": "True when the product page shows the item as in stock.",
          "example": true,
          "type": "boolean"
        },
        "brand_link": {
          "description": "URL of the brand's store page on Amazon. Omitted when the page shows none.",
          "example": "https://www.amazon.com/stores/Apple/page/77D9E1F7-0337-4282-9DB6-B6B8FB2DC98D",
          "type": "string"
        },
        "brand_name": {
          "description": "Brand name shown on the product page. Omitted when the page shows none.",
          "example": "Apple Store",
          "type": "string"
        },
        "customers_say": {
          "description": "Summary of what customers say about the product, from the \"Customers say\" section.",
          "type": "string"
        },
        "description": {
          "description": "Product description text, converted to Markdown.",
          "type": "string"
        },
        "images": {
          "description": "URLs of the product's gallery images.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "is_free_delivery": {
          "description": "True when the product page offers free delivery.",
          "example": true,
          "type": "boolean"
        },
        "is_free_return": {
          "description": "True when the product page offers free returns.",
          "example": true,
          "type": "boolean"
        },
        "link": {
          "description": "URL of the product page on Amazon.",
          "example": "https://www.amazon.com/dp/B0DGJ736JM/",
          "type": "string"
        },
        "low_confidence": {
          "description": "LowConfidence is true when the rating widget failed to parse (rating=0\nalongside a nonzero review count) on every hedge attempt, so the result\nis handed back unfiltered rather than discarded, but flagged as\nuntrusted and never cached as fresh.",
          "example": false,
          "type": "boolean"
        },
        "number_of_bought_in_last_month": {
          "description": "Number of units bought in the past month, as shown on the page (for example 1000 for \"1K+ bought\"). Zero when the page shows none.",
          "example": 1000,
          "type": "integer"
        },
        "overview": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key product facts from the overview table, as pairs of label and value.",
          "type": "object"
        },
        "price": {
          "description": "Current price of the product, in US dollars.",
          "example": 189,
          "type": "number"
        },
        "rating": {
          "description": "Average customer rating, out of 5.",
          "example": 4.4,
          "type": "number"
        },
        "rating_hist": {
          "additionalProperties": {
            "format": "float64",
            "type": "number"
          },
          "description": "Share of ratings for each star level, keyed by stars from `1` to `5`, with values from 0 to 1.",
          "type": "object"
        },
        "review_count": {
          "description": "Total number of customer ratings shown on the page.",
          "example": 1055,
          "type": "integer"
        },
        "review_images": {
          "description": "Customer-uploaded photos from the reviews section.",
          "items": {
            "$ref": "#/definitions/amazon.ReviewImage"
          },
          "type": "array"
        },
        "review_insights": {
          "description": "Topics customers mention most often in reviews, each with a sentiment.",
          "items": {
            "$ref": "#/definitions/amazon.ReviewInsight"
          },
          "type": "array"
        },
        "reviews": {
          "description": "Customer review samples shown on the product page.",
          "items": {
            "$ref": "#/definitions/amazon.Review"
          },
          "type": "array"
        },
        "seller_link": {
          "description": "URL of the seller's page on Amazon.",
          "example": "https://www.amazon.com/b?node=10158976011",
          "type": "string"
        },
        "seller_name": {
          "description": "Name of the seller offering the product.",
          "example": "Amazon Resale",
          "type": "string"
        },
        "title": {
          "description": "Product title as shown on the Amazon product page.",
          "example": "Apple Watch SE (2nd Gen) [GPS 40mm] Smartwatch with Midnight Aluminium Case with Midnight Sport Band S/M. Fitness and Sleep Trackers, Crash Detection, Heart Rate Monitor, Retina Display",
          "type": "string"
        }
      },
      "type": "object"
    },
    "amazon.Review": {
      "properties": {
        "content": {
          "description": "Text of the review.",
          "type": "string"
        },
        "country": {
          "description": "Country the review was written in, as shown in \"Reviewed in ...\".",
          "example": "United States",
          "type": "string"
        },
        "helpful_count": {
          "description": "Number of people who found the review helpful. Omitted when none are shown.",
