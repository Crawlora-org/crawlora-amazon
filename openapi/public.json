          "type": "string"
        },
        "number_of_bought_in_last_month": {
          "description": "Amazon's \"bought in past month\" figure. 0 when the card does not show one.",
          "example": 1000,
          "type": "integer"
        },
        "price": {
          "description": "Current price shown on the card.",
          "example": 189,
          "type": "number"
        },
        "rating": {
          "description": "Average star rating, out of 5.",
          "example": 4.4,
          "type": "number"
        },
        "review_count": {
          "description": "Number of ratings.",
          "example": 1055,
          "type": "integer"
        },
        "title": {
          "description": "Product title as shown on the result card.",
          "example": "Watch SE (2nd Gen) [GPS 40mm] Smartwatch with Midnight Aluminium Case with Midnight Sport Band S/M. Fitness and Sleep Trackers, Crash Detection, Heart Rate Monitor, Retina Display",
          "type": "string"
        }
      },
      "type": "object"
    },
