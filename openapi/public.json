          "type": "integer"
        },
        "link": {
          "description": "URL of the review on Amazon.",
          "type": "string"
        },
        "rating": {
          "description": "Star rating the reviewer gave, out of 5.",
          "example": 4,
          "type": "number"
        },
        "review_date": {
          "description": "Date the review was posted, in RFC 3339 format.",
          "type": "string"
        },
        "title": {
          "description": "Headline of the review.",
          "type": "string"
        },
        "user_link": {
          "description": "URL of the reviewer's profile on Amazon.",
          "type": "string"
        },
        "user_name": {
          "description": "Display name of the reviewer.",
          "type": "string"
        },
        "verified_purchase": {
          "description": "True when the review carries the Verified Purchase badge.",
          "example": true,
          "type": "boolean"
        }
      },
