        },
        "mentions": {
          "description": "Number of reviews that mention the topic.",
          "example": 41,
          "type": "integer"
        },
        "sentiment": {
          "description": "Overall sentiment of the mentions, for example `positive`.",
          "example": "positive",
          "type": "string"
        },
        "summary": {
          "description": "Short summary of what customers say about the topic.",
          "example": "Customers like the build quality.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "amazon.SearchResponseItem": {
