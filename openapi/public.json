    },
    "amazon.ReviewImage": {
      "properties": {
        "review_id": {
          "description": "Id of the review the photo belongs to. Omitted when not shown.",
          "example": "R31YRHYX7G6DNK",
          "type": "string"
        },
        "thumbnail": {
          "description": "URL of a smaller version of the photo. Omitted when not shown.",
          "example": "https://m.media-amazon.com/images/I/example._SY250_.jpg",
          "type": "string"
        },
        "url": {
          "description": "URL of the full-size photo.",
          "example": "https://m.media-amazon.com/images/I/example.jpg",
          "type": "string"
        }
      },
      "type": "object"
    },
    "amazon.ReviewInsight": {
      "properties": {
        "label": {
          "description": "Topic customers mention, for example `quality`.",
          "example": "quality",
          "type": "string"
        },
        "mention_percent": {
          "description": "Whole-number percentage Amazon reports alongside the topic's mention count.",
          "example": 98,
